# Copy to .env and fill in. .env is git-ignored; never commit real keys.

# Model strings are "provider:model". Supported providers: anthropic, openai.
LLM_MODEL=anthropic:claude-haiku-4-5
# Optional: a smaller/faster model just for routing. Defaults to LLM_MODEL.
# ROUTER_MODEL=anthropic:claude-haiku-4-5

# Only the key for the provider you use is required.
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Optional tuning
# LLM_TIMEOUT_S=30
# LLM_MAX_RETRIES=2
# ANSWER_MAX_TOKENS=1024
